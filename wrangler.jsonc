
{
  "name": "paas-express-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paas-students-db",
      "database_id": "397e5b4c-087e-4ece-bafd-6fa01950ecf7"
    }
  ],
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  }
}
